<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Recording with the screen off or another app in front: a foreground service of type microphone (Android 14
         requires the type and its permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The "Recording" notification with its Stop button (Android 13+ asks the person). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the CPU awake while recording so timers and the file writes keep running with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.remeinium.aution.recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
